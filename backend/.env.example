# Copiez ce fichier en .env pour le développement local (non commité sur Git)

DJANGO_SECRET_KEY=change-moi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Laissez vide en local (utilise SQLite par défaut).
# En production (Render), Render la fournit automatiquement si vous
# utilisez une base Postgres liée, ou collez l'URL Neon.tech ici :
# DATABASE_URL=postgresql://user:password@host/dbname
# DJANGO_DB_SSL_REQUIRE=True

# Laissez vide pour stocker les médias localement (dev uniquement).
# En production, créez un compte gratuit sur cloudinary.com et collez
# l'URL "API Environment variable" (CLOUDINARY_URL) fournie dans votre tableau de bord :
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
